# GitHub Actions secrets — fill values in GitHub → Settings → Secrets
# Generated from live MCP checks (Supabase + Cloudflare). Do NOT commit real secrets.

# ── GCP / Cloud Run ─────────────────────────────────────────
GCP_PROJECT_ID=
GCP_SA_KEY=

# ── App auth / DB / email ───────────────────────────────────
JWT_SECRET=
DATABASE_URL=
RESEND_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Firebase web (baked into frontend build) ────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=consignment-packing-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=consignment-packing-app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Cloudflare R2 (MCP: bucket consigmentapp, APAC, Standard) ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_BUCKET defaults to consigmentapp in deploy workflow

# ── Supabase Realtime only (MCP verified) ───────────────────
# Project: Consigment APP | ref: fakrpqlqcnctmiliqxjl | healthy | FREE
# Tables: none (keep empty — do not migrate app DB here)
VITE_SUPABASE_URL=https://fakrpqlqcnctmiliqxjl.supabase.co
VITE_SUPABASE_ANON_KEY=
# Paste JWT Secret from Supabase → Project Settings → API → JWT Secret
# (NOT the service_role key, NOT a JWT string)
SUPABASE_JWT_SECRET=

# ── Optional ────────────────────────────────────────────────
SHARE_LINK_SECRET=
BOOTSTRAP_SECRET=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_POSTHOG_KEY=

# NOT needed for this app:
# SUPABASE_ACCESS_TOKEN  → CLI/MCP only
# SUPABASE_DB_PASSWORD   → app uses DATABASE_URL, not free-tier Supabase DB

# Repo Variables:
# CLOUD_RUN_SERVICE=consignment-youthnic-git
# CLOUD_RUN_REGION=europe-west1
# CUSTOM_DOMAIN=https://consignment.youthnic.shop

# R2 custom domain (dashboard — Cloudflare MCP cannot attach domains yet):
# 1. R2 → consigmentapp → Settings → Custom Domains → Add
# 2. Use e.g. media.consignment.youthnic.shop (zone must be on same CF account)
# 3. Prefer this over *.r2.dev for production

# ── WhatsApp OpenWA ─────────────────────────────────────────
OPENWA_API_KEY=
WHATSAPP_SCHEDULER_SECRET=

