# Backend environment — copy to backend/.env
# Architecture: local/Cloud SQL Postgres = data | Firebase Auth = identity | Cloudflare R2 = files
#               Supabase Realtime = live sync only (Broadcast — keep free-tier DB/Storage empty)

PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Operational PostgreSQL (NOT the free-tier Supabase project)
# Format: postgresql://username:PASSWORD@IP_OR_HOST:5432/consignment_db
# CockroachDB Cloud example: postgresql://user:pass@xxx.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
# URL-encode special chars in password ($ → %24, @ → %40, etc.)
# Apply schema: node backend/scripts/apply-cockroach-schema.js  (Cockroach)
#            or: node backend/scripts/apply-all-migrations.js     (Postgres/Supabase/Neon)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/consignment_db
# SUPABASE_DB_URL is an alias for DATABASE_URL — do not point it at the Realtime-only project.
# SUPABASE_DB_URL=

# Supabase Realtime (Broadcast live sync only — no Storage, no app tables)
SUPABASE_URL=https://fakrpqlqcnctmiliqxjl.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# Optional: Project Settings → API → JWT Secret (only needed for private realtime tokens)
# SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret
# Optional: prefer service role for server-side broadcast (never expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: force Firebase ID-token revocation checks on login (extra Google API round-trip).
# Default is off — signature/expiry are always verified; deactivated users are blocked from the app DB.
# AUTH_CHECK_REVOKED=true
DB_USE_POSTGRES=true
DB_SSL=true


# Firebase Admin — Auth only (videos/documents use Cloudflare R2 below)
# Place service account JSON at backend/serviceAccountKey.json (gitignored)
# Download: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=consignment-packing-app
FIREBASE_AUTH_DOMAIN=consignment-packing-app.firebaseapp.com

# Cloudflare R2 — videos, weight images, documents
# Create an R2 bucket + S3 API token in the Cloudflare dashboard
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=consigmentapp
# Optional overrides:
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://media.your-domain.com
# R2_SIGNED_UPLOAD_TTL_SECONDS=3600
# Longer TTL helps large box videos (50–100MB) finish uploading on slower links
# R2_SIGNED_READ_TTL_SECONDS=3600

# Email — Mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain.com
MAIL_FROM_EMAIL=consignment@youthnic.shop
MAIL_FROM_NAME="Consignment App"
MAIL_USER_DOMAIN=yourdomain.com
# EMAIL_OPTIONAL=true
# Absolute logo URL used in branded emails (defaults to APP_URL/brand-logo.png)
# EMAIL_LOGO_URL=https://consignment.youthnic.shop/brand-logo.png
APP_URL=https://consignment.youthnic.shop
# Optional: absolute API origin for durable share links / email logo (defaults to APP_URL)
# PUBLIC_API_URL=https://consignment.youthnic.shop
# PUBLIC_API_URL=https://your-app.example.com
# Optional override for share-link HMAC (defaults to JWT_SECRET)
# SHARE_LINK_SECRET=

# Local Postgres encrypted backups (see docs/BACKUP_RESTORE.md)
# BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-32-chars
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_ALERT_TO=admin@yourdomain.com

# CORS (production)
# ALLOWED_ORIGINS=https://your-app.example.com

# Optional: Firebase web API key (same as VITE_FIREBASE_API_KEY) — used to verify
# current password on self-service password change without storing local hashes.
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Optional admin bootstrap
# ADMIN_EMAIL=returnorders@vbexports.co.in
# ADMIN_PASSWORD=your-strong-admin-password
# ADMIN_NAME=Pawan Shukla
# BOOTSTRAP_SECRET=random-secret-for-post-deploy-admin-resync

# Better Stack Logs (Logtail) Token
# Obtain from Better Stack console → Sources
LOGTAIL_SOURCE_TOKEN=
