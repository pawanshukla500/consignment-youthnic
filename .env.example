# ═══════════════════════════════════════════════════════════
# Consignment Packing App — Environment reference
# Copy values to:
#   backend/.env   ← API server (see backend/.env.example)
#   frontend/.env  ← Vite SPA (see frontend/.env.example)
# ═══════════════════════════════════════════════════════════
#
# Architecture:
#   Firebase  → Authentication + Storage (videos, documents)
#   Supabase  → PostgreSQL (all application / business data)
#   Backend   → API connecting both services

# Required realtime/auth bridge:
#   backend/.env: SUPABASE_JWT_SECRET
#   frontend/.env: VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY
# Safety:
#   ALLOW_MEMORY_FALLBACK=false
#   ALLOW_FIRESTORE_DATA=false
#   ALLOW_LEGACY_PASSWORD_LOGIN=false
